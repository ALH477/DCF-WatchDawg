# ---- stage 1: build dcf-gate from the vendored C (gate/). Needs a C compiler,
# not exsc and not fasmg. The Makefile runs `dcf-gate selftest` as part of the
# build, so an image whose gate answers wrongly does not get built.
FROM alpine:3.21 AS gate
RUN apk add --no-cache build-base
WORKDIR /src
COPY gate/ gate/
RUN make -C gate LDFLAGS="-static-pie -Wl,-z,relro,-z,now" \
 && ./gate/dcf-gate selftest

# ---- stage 2: the runtime. curl and python3 are not installed: nothing here
# uses them (jq validates status.json).
FROM alpine:3.21

RUN apk add --no-cache \
    bash \
    nftables \
    sqlite \
    gawk \
    coreutils \
    iproute2 \
    jq \
    && rm -rf /var/cache/apk/*

# The single binary from stage 1. root-owned, not writable by anyone else: the
# watchdog refuses to run a gate (or a telemetry script) that is.
COPY --from=gate /src/gate/dcf-gate /usr/local/bin/dcf-gate
RUN chmod 755 /usr/local/bin/dcf-gate \
 && dcf-gate selftest

# Create directories
RUN mkdir -p /data /scripts

# Copy scripts
COPY dcf-watchdog.sh /scripts/dcf-watchdog.sh
COPY dcf-telemetry.sh /scripts/dcf-telemetry.sh
COPY dcf-healthcheck.sh /scripts/dcf-healthcheck.sh
COPY dcf-common.sh /scripts/dcf-common.sh

# The three scripts run; dcf-common.sh is sourced by them and is not executable.
RUN chmod 755 /scripts/dcf-watchdog.sh /scripts/dcf-telemetry.sh /scripts/dcf-healthcheck.sh \
 && chmod 644 /scripts/dcf-common.sh

# Environment
ENV DB_PATH=/data/identity.db
ENV WEB_ROOT=/data/public
ENV DCF_PORT=7777
ENV LOG_LEVEL=info

# Healthy = the firewall chain still has its drop rule and, when telemetry is
# enabled (TELEMETRY_SCRIPT=/scripts/dcf-telemetry.sh), status.json is fresh.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["/scripts/dcf-healthcheck.sh"]

# bash -p: do not read $BASH_ENV / $ENV, do not import shell functions from the
# environment. (The script drops them for everything it starts; only this keeps
# bash itself from reading them first.)
ENTRYPOINT ["/bin/bash", "-p", "/scripts/dcf-watchdog.sh"]
